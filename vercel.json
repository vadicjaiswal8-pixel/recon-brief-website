{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/blog/company-research-guide",
      "destination": "/blog/company-research-guide/article"
    }
  ],
  "redirects": [
    {
      "source": "/samples/company-research/the-whole-truth-foods",
      "destination": "/samples",
      "permanent": true
    },
    {
      "source": "/samples/company-research/the-whole-truth-foods/",
      "destination": "/samples",
      "permanent": true
    }
  ]
}
