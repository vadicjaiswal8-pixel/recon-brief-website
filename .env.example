# Recon Brief contact form: copy these names into Vercel, never commit real values.
# Vercel: Project > Settings > Environment Variables (add for Production, and Preview if you test there).

# REQUIRED. The Send Mail token / API key of agent_1 (Zoho CPaaS > Agents > agent_1 > SMTP/API).
# Paste ONLY the key. The code adds the 'Zoho-enczapikey ' prefix itself (a pasted prefix, quotes or
# line breaks are removed automatically, and the log tells you if that was needed).
ZOHO_CPAAS_API_KEY=your_zoho_cpaas_api_key_here

# Optional. Defaults to the India-region endpoint shown in your Zoho account.
ZOHO_CPAAS_API_URL=https://cpaas.zoho.in/v1.1/email

# Optional. Defaults shown. The sender must be a verified address on reconbrief.in.
CONTACT_FROM_EMAIL=support@reconbrief.in
CONTACT_TO_EMAIL=support@reconbrief.in

# Optional. Extra origins allowed to call /api/contact (comma separated).
# www.reconbrief.in, reconbrief.in and this deployment's own Vercel URL are always allowed.
CONTACT_ALLOWED_ORIGINS=

# Recommended. Shared storage for rate limiting across serverless instances.
# Add an Upstash Redis database from the Vercel Marketplace and these are filled in for you
# (the KV_REST_API_URL / KV_REST_API_TOKEN names are also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
